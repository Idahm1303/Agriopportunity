# Copy this file to .env.local and replace the placeholders with Neon connection URLs.
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<direct-host>/<database>?sslmode=require"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"
OPENAI_API_KEY="your-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
AWS_S3_BUCKET="agriopportunity-documents"
AWS_ENDPOINT_URL_S3="https://your-neon-object-storage-endpoint"
AWS_REGION="your-neon-object-storage-region"
AWS_ACCESS_KEY_ID="your-neon-object-storage-access-key"
AWS_SECRET_ACCESS_KEY="your-neon-object-storage-secret-key"