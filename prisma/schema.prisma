generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String             @id @default(uuid())
  email                   String             @unique
  passwordHash            String
  role                    Role               @default(LEARNER)
  province                String?
  preferredLanguage       String             @default("English")
  fullName                String
  organizationName        String?
  phoneNumber             String?
  address                 String?
  location                String?
  skills                  String[]
  qualifications          String[]
  verificationStatus      String             @default("pending")
  verificationDocumentUrl String?
  createdAt               DateTime           @default(now())
  applications            Application[]
  opportunities           Opportunity[]      @relation("PostedBy")
  documents               Document[]
  reports                 Report[]
  savedOpportunities      SavedOpportunity[]
  roles                   UserRole[]
  farmerProfile           FarmerProfile?
  smmeProfile             SmmeProfile?
  smmeDiagnostics         SmmeDiagnostic[]
  recommendations         OpportunityRecommendation[]
}

enum Role {
  LEARNER
  FARMER
  SMME
  COOPERATIVE
  EMPLOYER
  PROVIDER
  ADMIN
}

model UserRole {
  userId    String
  role      Role
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, role])
  @@map("user_roles")
}

model FarmerProfile {
  userId                  String   @id
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  farmName                String?
  province                String
  district                String?
  farmSizeHectares        Float?
  farmingType             String?
  mainCommodities         String[] @default([])
  yearsFarming            Int?
  farmerStage             String?
  landTenure              String?
  hasRegisteredBusiness   Boolean  @default(false)
  needs                   String[] @default([])
  updatedAt               DateTime @updatedAt

  @@map("farmer_profiles")
}

model SmmeProfile {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName        String?
  entityType          String?
  registrationNumber  String?
  cipcRegistered      Boolean  @default(false)
  sectorFocus         String?
  employeesCount      Int?
  yearsTrading        Int?
  annualTurnoverBand  String?
  province            String
  fundingStage        String?
  needs               String[] @default([])
  updatedAt           DateTime @updatedAt

  @@map("smme_profiles")
}

model SmmeDiagnostic {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers   Json
  score     Int
  gaps      Json
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("smme_diagnostics")
}

enum OpportunityType {
  job
  learnership
  bursary
  funding
  internship
  graduate_placement
  skills_programme
  artisan
  mentorship
  research
  smme_programme
  funding_call
}

model Opportunity {
  id                 String             @id @default(uuid())
  title              String
  description        String
  category           String
  type               OpportunityType   @default(job)
  targetAudience     String[]          @default([])
  province           String?
  closingDate        DateTime?
  fundingAmountRange String?
  eligibilityCriteria Json?
  applyUrl           String?
  location           String?
  applicationEmail   String?
  requiredSkills     String[]
  postedBy           User               @relation("PostedBy", fields: [postedById], references: [id])
  postedById         String
  status             String             @default("open")
  publishedAt        DateTime?
  expiresAt          DateTime?
  closedAt           DateTime?
  paymentRequestFlag Boolean            @default(false)
  viewCount          Int                @default(0)
  createdAt          DateTime           @default(now())
  applications       Application[]
  documents          Document[]
  reports            Report[]
  savedBy            SavedOpportunity[]
  recommendations    OpportunityRecommendation[]
}

model OpportunityRecommendation {
  userId        String
  opportunityId String
  matchScore    Int
  matchReason   String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@id([userId, opportunityId])
  @@index([userId, matchScore])
  @@map("opportunity_recommendations")
}

model Application {
  id                        String      @id @default(uuid())
  user                      User        @relation(fields: [userId], references: [id])
  userId                    String
  opportunity               Opportunity @relation(fields: [opportunityId], references: [id])
  opportunityId             String
  status                    String      @default("submitted")
  matchScore                Float?
  coverNote                 String?
  cvUrl                     String?
  employerEmailSentAt       DateTime?
  learnerEmailSentAt        DateTime?
  emailError                String?
  qualificationDocumentName String?
  extractedText             String?
  extractedQualifications   String[]    @default([])
  extractedSkills           String[]    @default([])
  matchedSkills             String[]    @default([])
  verifiedAt                DateTime?
  verifiedBy                String?
  placedAt                  DateTime?
  placedBy                  String?
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt
  documents                 Document[]
  statusHistory             ApplicationStatusHistory[]

  @@unique([userId, opportunityId])
}

model ApplicationStatusHistory {
  id            String      @id @default(uuid())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  status        String
  changedBy     String?
  changedAt     DateTime    @default(now())
}

model Document {
  id                      String       @id @default(uuid())
  user                    User         @relation(fields: [userId], references: [id])
  userId                  String
  opportunity             Opportunity? @relation(fields: [opportunityId], references: [id])
  opportunityId           String?
  application             Application? @relation(fields: [applicationId], references: [id])
  applicationId           String?
  documentType            String
  fileName                String
  storageUrl              String?
  extractedText           String?
  extractedData           Json?
  extractionStatus         String       @default("pending_confirmation")
  extractedQualifications String[]     @default([])
  extractedSkills         String[]     @default([])
  confidence              Float?
  confirmedAt             DateTime?
  createdAt               DateTime     @default(now())
}

model Report {
  id             String      @id @default(uuid())
  opportunity    Opportunity @relation(fields: [opportunityId], references: [id])
  opportunityId  String
  reporter       User        @relation(fields: [reporterUserId], references: [id])
  reporterUserId String
  reason         String
  status         String      @default("open")
  resolutionNote String?
  createdAt      DateTime    @default(now())
  resolvedAt     DateTime?
}

model SavedOpportunity {
  applicant     User        @relation(fields: [applicantId], references: [id])
  applicantId   String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id])
  opportunityId String
  savedAt       DateTime    @default(now())

  @@id([applicantId, opportunityId])
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String
  entityId    String
  performedBy String?
  details     String?
  createdAt   DateTime @default(now())
}
