generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  passwordHash  String
  role          Role          @default(LEARNER)
  fullName      String
  organizationName String?
  phoneNumber   String?
  address       String?
  location      String?
  skills        String[]
  qualifications String[]
  createdAt     DateTime      @default(now())
  applications  Application[]
  opportunities Opportunity[] @relation("PostedBy")
}

enum Role {
  LEARNER
  EMPLOYER
  ADMIN
}

model Opportunity {
  id             String        @id @default(uuid())
  title          String
  description    String
  category       String
  location       String?
  requiredSkills String[]
  postedBy       User          @relation("PostedBy", fields: [postedById], references: [id])
  postedById     String
  status         String        @default("open")
  publishedAt    DateTime?
  expiresAt      DateTime?
  closedAt       DateTime?
  createdAt      DateTime      @default(now())
  applications   Application[]
}

model Application {
  id            String       @id @default(uuid())
  user          User         @relation(fields: [userId], references: [id])
  userId        String
  opportunity   Opportunity  @relation(fields: [opportunityId], references: [id])
  opportunityId String
  status        String       @default("submitted")
  matchScore    Float?
  qualificationDocumentName String?
  extractedText String?
  extractedQualifications String[] @default([])
  extractedSkills String[] @default([])
  matchedSkills String[] @default([])
  verifiedAt    DateTime?
  verifiedBy    String?
  placedAt      DateTime?
  placedBy      String?
  createdAt     DateTime     @default(now())
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  entityType  String
  entityId    String
  performedBy String?
  details     String?
  createdAt   DateTime @default(now())
}
